{
  "name": "modu-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "墨读：支持 EPUB / PDF / TXT / MOBI 的安卓电子书阅读器（Capacitor + React）",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "fixtures": "node scripts/make-fixtures.mjs",
    "cap:sync": "npm run build && cap sync",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@lingo-reader/mobi-parser": "0.4.6",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "dompurify": "3.3.0",
    "epubjs": "0.3.93",
    "jschardet": "4.1.0",
    "lucide-react": "1.67.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "28.0.0",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
